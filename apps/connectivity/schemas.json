{
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Invalid request" }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "DeliveryInput": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "command_service": {
                "type": "string",
                "example": "heating",
                "enum": ["heating"]
              },
              "command_id": {
                "type": "string",
                "example": "123e4567-e89b-42d3-a456-426614174000",
                "format": "uuid"
              },
              "device_id": { "type": "integer", "minimum": 1, "example": 1 },
              "operation": {
                "type": "string",
                "example": "SET_HEATING",
                "enum": ["SET_HEATING"]
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "enabled": { "type": "boolean", "example": true }
                },
                "required": ["enabled"],
                "additionalProperties": false
              }
            },
            "required": [
              "command_service",
              "command_id",
              "device_id",
              "operation",
              "parameters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "command_service": {
                "type": "string",
                "example": "lighting",
                "enum": ["lighting"]
              },
              "command_id": {
                "type": "string",
                "example": "123e4567-e89b-42d3-a456-426614174000",
                "format": "uuid"
              },
              "device_id": { "type": "integer", "minimum": 1, "example": 1 },
              "operation": {
                "type": "string",
                "example": "SET_LIGHT",
                "enum": ["SET_LIGHT"]
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "enabled": { "type": "boolean", "example": true }
                },
                "required": ["enabled"],
                "additionalProperties": false
              }
            },
            "required": [
              "command_service",
              "command_id",
              "device_id",
              "operation",
              "parameters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "command_service": {
                "type": "string",
                "example": "gates",
                "enum": ["gates"]
              },
              "command_id": {
                "type": "string",
                "example": "123e4567-e89b-42d3-a456-426614174000",
                "format": "uuid"
              },
              "device_id": { "type": "integer", "minimum": 1, "example": 1 },
              "operation": {
                "type": "string",
                "example": "SET_GATE_LOCK",
                "enum": ["SET_GATE_LOCK"]
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "locked": { "type": "boolean", "example": true }
                },
                "required": ["locked"],
                "additionalProperties": false
              }
            },
            "required": [
              "command_service",
              "command_id",
              "device_id",
              "operation",
              "parameters"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Delivery": {
        "type": "object",
        "properties": {
          "command_service": {
            "type": "string",
            "example": "heating",
            "enum": ["heating", "lighting", "gates"]
          },
          "command_id": {
            "type": "string",
            "example": "123e4567-e89b-42d3-a456-426614174000",
            "format": "uuid"
          },
          "device_id": { "type": "integer", "minimum": 1, "example": 1 },
          "status": {
            "type": "string",
            "example": "PENDING",
            "enum": ["PENDING", "ACCEPTED", "SUCCEEDED", "FAILED", "UNKNOWN"],
            "description": "ACCEPTED means the device accepted the command; SUCCEEDED means execution was confirmed; UNKNOWN means the outcome is unknown. Command status does not replace reading the device state."
          },
          "updated_at": {
            "type": "string",
            "example": "2026-10-07T09:00:00Z",
            "format": "date-time"
          }
        },
        "required": [
          "command_service",
          "command_id",
          "device_id",
          "status",
          "updated_at"
        ],
        "additionalProperties": false
      },
      "DeviceState": {
        "type": "object",
        "properties": {
          "device_id": { "type": "integer", "minimum": 1, "example": 1 },
          "kind": {
            "type": "string",
            "example": "HEATING",
            "enum": ["HEATING", "LIGHT", "GATE"]
          },
          "state": {
            "type": "string",
            "example": "ON",
            "enum": ["ON", "OFF", "LOCKED", "UNLOCKED"]
          },
          "observed_at": {
            "type": "string",
            "example": "2026-10-07T09:00:00Z",
            "format": "date-time"
          }
        },
        "required": ["device_id", "kind", "state", "observed_at"],
        "additionalProperties": false,
        "description": "HEATING/LIGHT: ON or OFF; GATE: LOCKED or UNLOCKED. Returns confirmed observations only; a failed state read returns an HTTP error.",
        "oneOf": [
          {
            "properties": {
              "kind": { "enum": ["HEATING", "LIGHT"] },
              "state": { "enum": ["ON", "OFF"] }
            }
          },
          {
            "properties": {
              "kind": { "enum": ["GATE"] },
              "state": { "enum": ["LOCKED", "UNLOCKED"] }
            }
          }
        ]
      },
      "ConnectionCheck": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "example": "heating" },
          "connection_mode": {
            "type": "string",
            "example": "HTTPS",
            "enum": ["HTTPS", "LEGACY"]
          },
          "connection_settings": {
            "type": "object",
            "properties": {
              "model": { "type": "string", "example": "demo-v1" },
              "address": {
                "type": "string",
                "example": "https://device.example.test",
                "format": "uri"
              },
              "credential_ref": {
                "type": "string",
                "example": "device-secret-1"
              }
            },
            "required": ["model", "address"],
            "additionalProperties": false,
            "description": "Address on an allowed device network; new devices use HTTPS. credential_ref is a server-side reference to a secret, not a password. Arbitrary external addresses are not allowed."
          }
        },
        "required": ["type", "connection_mode", "connection_settings"],
        "additionalProperties": false
      }
    }
  }
}
