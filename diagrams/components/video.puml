@startuml
!include <C4/C4_Component>
title Warmhouse — Components: Video Control
LAYOUT_TOP_DOWN()
skinparam nodesep 30
skinparam ranksep 50
Container(client, "Client / Automation", "HTTPS / HTTP", "Camera commands; client views the stream directly")
Container(idp, "Keycloak", "OIDC / JWKS", "JWT verification keys")
Container(access, "Home Access", "HTTP API", "Separate viewing and control permissions")
Container(registry, "Device Registry", "HTTP API", "Camera, home and active binding")
Container(broker, "RabbitMQ", "AMQP", "Commands and results; internal vhost")
Container_Boundary(service, "Video Control") {
  Component(api, "Camera API", "HTTP", "Commands, statuses and stream URLs")
  Component(auth, "Access Validation", "Module", "JWT / service identity; author permissions and camera binding")
  Component(commands, "Command Handler", "Module", "Camera capabilities; Command + sequence + outbox")
  Component(results, "Result Consumer", "Consumer", "Dedup and resultVersion; binding validation")
  Component(relay, "Outbox Relay", "Background worker", "CommandRequested; mandatory + confirm without return")
  Component(links, "Stream URL Issuer", "Module", "Enforces access and expiry through camera capabilities")
}
System_Ext(camera, "Compatible Camera", "HTTPS API for temporary URLs; secure browser stream")
ContainerDb(db, "Video DB", "PostgreSQL", "Commands, results, outbox and stream profiles")
Rel(client, api, "Commands / statuses / URL")
Rel(api, auth, "Validates the request")
Rel(auth, idp, "Fetches JWKS")
Rel(auth, registry, "Camera / home / binding")
Rel(auth, access, "Operation permission")
Rel(api, links, "After access validation")
Rel(links, db, "Reads stream profile")
Rel(links, camera, "Temporary URL", "Camera HTTPS API")
Rel(client, camera, "Video stream; signature and TTL", "HLS / HTTPS for a compatible profile")
Rel(api, commands, "Command after permission checks")
Rel(commands, registry, "Capabilities / commandOwner")
Rel(commands, db, "Command + sequence + outbox", "Transaction")
Rel(relay, db, "Reads / marks outbox messages")
Rel(relay, broker, "CommandRequested")
Rel(broker, results, "CommandResult / DeliveryClosed")
Rel(results, registry, "CommandResult binding validity")
Rel(results, db, "Status + dedup", "Transaction")
SHOW_LEGEND()
@enduml
