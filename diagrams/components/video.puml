@startuml
!include <C4/C4_Component>

title Warmhouse — компоненты сервиса видеонаблюдения
LAYOUT_TOP_DOWN()

Container(web, "Веб-клиент", "Браузер", "Просмотр видео")
Container(proxy, "Обратный прокси", "Nginx", "Запросы API")

Container_Boundary(video, "Видеонаблюдение") {
    Component(api, "HTTP API", "Обработчик запроса", "Принимает ID камеры; возвращает ссылку и срок её действия")
    Component(stream, "Получение ссылки", "Логика сервиса", "Проверяет тип устройства и получает временную ссылку на поток")
    Component(monolithClient, "Клиент монолита", "HTTP-клиент", "Читает настройки камеры из реестра")
    Component(cameraClient, "Адаптер камеры", "HTTPS-клиент", "Запрашивает временную ссылку через API камеры")
}

Container(monolith, "Монолит", "Go / Gin", "Реестр и настройки камер")
System_Ext(camera, "Камера партнёра", "API временных ссылок и поток, доступный браузеру")

Rel(web, proxy, "Запрашивает ссылку по ID камеры", "HTTPS")
Rel(proxy, api, "Передаёт запрос", "HTTP")
Rel(api, stream, "Получить ссылку", "Вызов")
Rel(stream, monolithClient, "Получить настройки камеры", "Вызов")
Rel(monolithClient, monolith, "Читает запись камеры", "HTTP")
Rel(stream, cameraClient, "Получить временную ссылку", "Вызов")
Rel(cameraClient, camera, "Запрашивает ссылку", "HTTPS")
Rel(web, camera, "Смотрит поток по полученной ссылке", "HTTPS")

note bottom of stream
  Ссылка возвращается по той же цепочке запросов.
  После её истечения клиент запрашивает новую.
  Ошибка камеры возвращается пользователю.
  Постоянные учётные данные камеры в браузер не передаются.
end note

note bottom of cameraClient
  MVP: просмотр потока совместимой камеры.
  Без записи, поворота камеры и обработки видео.
  Поток идёт напрямую в браузер.
  Своя БД сервису не нужна.
end note
@enduml
