@startuml
!include <C4/C4_Component>

title Warmhouse — компоненты монолита при интеграции MVP
LAYOUT_TOP_DOWN()

Container(proxy, "Обратный прокси", "Nginx", "Старый API, регистрация и настройки")
Container(telemetry, "Телеметрия", "HTTP API", "Хранит измерения; опрашивает старые датчики")
Container(connectivity, "Взаимодействие с устройствами", "HTTP API", "Проверяет связь; доставляет команды")
Container(video, "Видеонаблюдение", "HTTP API", "Получает настройки камер")

Container_Boundary(monolith, "Монолит — Go / Gin") {
    Component(api, "Пользовательский API", "SensorHandler — расширить", "Старые маршруты; регистрация и настройки новых типов устройств")
    Component(registry, "Реестр устройств", "Пакет db / pgx — расширить", "Хранит карточки, типы, способ подключения и параметры устройств")
    Component(temperatureClient, "Клиент температуры", "TemperatureService — перенастроить", "Получает сохранённые показания из телеметрии")
    Component(connectivityClient, "Клиент взаимодействия", "HTTP-клиент — добавить", "Передаёт введённые параметры для проверки связи")
    Component(internalApi, "Внутренний API", "Обработчики — добавить", "Чтение реестра без показаний; опрос, команды и состояние старого оборудования")
    Component(legacy, "Адаптер старого оборудования", "Протокол оборудования — добавить", "Опрос датчиков, команды отоплению и чтение состояния; для демо — имитация")
}

ContainerDb(db, "База монолита", "PostgreSQL", "Существующие записи устройств и новые параметры подключения")
System_Ext(equipment, "Старое оборудование", "Датчики и контроллеры отопления")

Rel(proxy, api, "Запросы пользователя", "HTTP")
Rel(api, registry, "Читает и меняет записи", "Вызов")
Rel(api, temperatureClient, "Получает температуру для ответа", "Вызов")
Rel(temperatureClient, telemetry, "Совместимый API температуры", "HTTP")
Rel(api, connectivityClient, "Проверяет подключение перед сохранением", "Вызов")
Rel(connectivityClient, connectivity, "Параметры проверяемого устройства", "HTTP")
Rel(telemetry, internalApi, "Реестр / опрос старых датчиков", "HTTP")
Rel(connectivity, internalApi, "Настройки / операции со старым устройством", "HTTP")
Rel(video, internalApi, "Настройки камеры", "HTTP")
Rel(internalApi, registry, "Читает карточки и настройки", "Вызов")
Rel(internalApi, legacy, "Опрос, команда или состояние", "Вызов")
Rel(registry, db, "Читает и сохраняет устройства", "SQL")
Rel(legacy, equipment, "Работает с оборудованием", "Старый протокол")

note bottom of internalApi
  Реестр возвращается без обращения к телеметрии.
  Операции с оборудованием не вызывают сервис взаимодействия.
  Так внутренние вызовы не образуют цикл.
end note

note bottom of registry
  Реестр остаётся в монолите; историю измерений хранит телеметрия.
  Способ подключения определяет маршрут: старый API или HTTPS.
  Исходный код содержит учёт сенсоров и HTTP-клиент температуры;
  новые типы, параметры подключения и операции с оборудованием
  на этой схеме — проектируемые доработки.
end note
@enduml
