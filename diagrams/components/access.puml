@startuml
!include <C4/C4_Component>
title Warmhouse — Components: Home Access
LAYOUT_TOP_DOWN()
skinparam nodesep 30
skinparam ranksep 50

Container(client, "Web Client / Services", "HTTPS / HTTP", "JWT / service identity")
Container(idp, "Keycloak", "OIDC / JWKS", "JWT keys; JWKS cache")
Container(broker, "RabbitMQ", "AMQP", "AccessChanged; internal vhost")
Container_Boundary(service, "Home Access") {
  Component(api, "Home and Access API", "HTTP", "Home creation, members, permission queries")
  Component(auth, "Access Validation", "Module", "JWT: issuer, audience, expiry; service identity")
  Component(policy, "Access Policy", "Module", "Owner, member, action; allowed changes")
  Component(relay, "Outbox Relay", "Background worker", "AccessChanged; mandatory + confirm without basic.return")
  Component(repo, "Home and Membership Repository", "SQL", "User linked by Keycloak subject; no passwords stored")
}
ContainerDb(db, "Access DB", "PostgreSQL", "Dedicated database and role")

Rel(client, api, "Requests an operation")
Rel(api, auth, "Authenticates the request")
Rel(auth, idp, "Fetches JWKS")
Rel(api, policy, "After identity verification")
Rel(policy, repo, "Validates and updates membership")
Rel(repo, db, "Permissions + version + outbox in one transaction")
Rel(relay, db, "Reads / marks outbox messages")
Rel(relay, broker, "AccessChanged: home, user, permission version")
SHOW_LEGEND()
@enduml
