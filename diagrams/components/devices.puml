@startuml
!include <C4/C4_Component>
title Warmhouse — Components: Device Registry
LAYOUT_TOP_DOWN()
skinparam nodesep 30
skinparam ranksep 50

Container(client, "Web Client / Services", "HTTPS / HTTP", "JWT / service identity")
Container(monolith, "Monolith / Legacy Adapter", "Go / Gin", "Reads device records and profiles from the registry")
Container(idp, "Keycloak", "OIDC / JWKS", "JWT keys; JWKS cache")
Container(access, "Home Access", "HTTP API", "Validates current home permissions")
Container(broker, "RabbitMQ", "AMQP", "ProvisioningRequested / Completed; DeviceBindingChanged")
Container_Boundary(service, "Device Registry") {
  Component(api, "Device API", "HTTP", "Registration, update, deletion, connectivity profile")
  Component(auth, "Access Validation", "Module", "JWT: issuer, audience, expiry; service identity")
  Component(manager, "Registration and Profile Manager", "Module", "Type, uniqueness and pairing; home binding")
  Component(lifecycle, "Binding Lifecycle", "Consumer / outbox relay", "PENDING → ACTIVE; revocation and bindingVersion")
  Component(repo, "Device Repository", "SQL", "ID, home, bindingVersion, status, commandOwner, capabilities and connectivity profile")
}
ContainerDb(db, "Devices DB", "PostgreSQL", "Dedicated database and role")

Rel(monolith, api, "Device records and profiles", "HTTP / service authentication")
Rel(client, api, "Manages devices / reads profiles")
Rel(api, auth, "Verifies identity")
Rel(auth, idp, "Fetches JWKS")
Rel(auth, access, "Checks permissions for the target home")
Rel(api, manager, "Executes the authorized operation")
Rel(manager, repo, "Accesses the registry")
Rel(repo, db, "Binding + outbox in one transaction")
Rel(lifecycle, db, "State + outbox in one transaction")
Rel(lifecycle, broker, "ProvisioningRequested / DeviceBindingChanged")
Rel(broker, lifecycle, "ProvisioningCompleted")
SHOW_LEGEND()
@enduml
