@startuml
!include <C4/C4_Component>

title Warmhouse — компоненты сервиса взаимодействия с устройствами
LAYOUT_TOP_DOWN()

Container(heating, "Отопление", "HTTP API", "Команды и состояние отопления")
Container(lighting, "Освещение", "HTTP API", "Команды и состояние света")
Container(gates, "Ворота", "HTTP API", "Команды и состояние ворот")
Container(monolith, "Монолит", "Go / Gin", "Регистрация, настройки и API старого оборудования")

Container_Boundary(connectivity, "Взаимодействие с устройствами") {
    Component(api, "HTTP API", "Обработчики запросов", "Принимает команду, запрос состояния или проверку связи; проверяет параметры")
    Component(handler, "Обработчик операций", "Логика сервиса", "Выбирает адаптер; учитывает повторы команд; возвращает результат")
    Component(monolithClient, "Клиент монолита", "HTTP-клиент", "Читает настройки; вызывает внутренний API старого оборудования")
    Component(deviceClient, "Адаптер новых устройств", "HTTPS-клиент", "Проверяет связь, отправляет команды и читает состояние")
}

ContainerDb(db, "Попытки доставки", "PostgreSQL: схема connectivity", "ID команды, параметры, состояние попытки и результат")
System_Ext(equipment, "Новые устройства", "Поддерживаемый HTTPS API")

Rel(heating, api, "Команда / состояние", "HTTP")
Rel(lighting, api, "Команда / состояние", "HTTP")
Rel(gates, api, "Команда / состояние", "HTTP")
Rel(monolith, api, "Проверка связи по введённым параметрам", "HTTP")
Rel(api, handler, "Передаёт проверенный запрос", "Вызов")
Rel(handler, db, "Сохраняет попытку до отправки и её результат", "SQL")
Rel(handler, monolithClient, "Настройки; операции со старым устройством", "Вызов")
Rel(handler, deviceClient, "Операции с новым устройством", "Вызов")
Rel(monolithClient, monolith, "Реестр / внутренний API оборудования", "HTTP")
Rel(deviceClient, equipment, "Проверка связи, команда, состояние", "HTTPS")

note bottom of handler
  Один ID команды — одна сохранённая попытка.
  Повтор с другими параметрами отклоняется;
  с теми же — возвращает сохранённый статус.
  Неясный исход отправки — UNKNOWN, без повторной отправки.
  Состояние оборудования запрашивается отдельно
  и возвращается со временем наблюдения.
end note

note bottom of monolithClient
  При проверке нового устройства параметры приходят в запросе:
  запись в реестре ещё не обязательна.
  Внутренний API старого оборудования работает напрямую,
  не вызывает этот сервис повторно.
end note
@enduml
