@startuml
!include <C4/C4_Component>
title Warmhouse — Components: Device Connectivity
LAYOUT_TOP_DOWN()
skinparam nodesep 30
skinparam ranksep 50

Container(registry, "Device Registry", "HTTP API", "Home, binding and device profile")
Container(access, "Home Access", "HTTP API", "Current permission of the command author")
Container(broker, "RabbitMQ", "AMQP", "Internal vhost; ACK / confirms")
Container(device_bus, "RabbitMQ: Device Vhost", "MQTT / TLS", "Same broker; topic, exchange and queue ACLs")
System_Ext(devices, "Modern Devices", "MQTT / TLS or HTTPS polling; readings and results")
Container(monolith, "Monolith / Legacy Adapter", "HTTP API", "Legacy protocol and equipment access")
Container_Boundary(service, "Device Connectivity") {
  Component(expiry, "Expiry and Cancellation Worker", "Background worker", "Expiry / cancellation; DeliveryClosed and resultVersion")
  Component(inbox, "Internal Request Consumer", "AMQP consumer", "CommandRequested / PollRequested; inbox before ACK")
  Component(dispatcher, "Delivery Dispatcher", "Background worker", "Permissions, binding, TTL and sequence; one command per device")
  Component(mqtt, "MQTT Adapter", "AMQP ↔ MQTT vhost", "Dispatches commands; accepts messages only from the authorized device topic")
  Component(http, "Device HTTP Adapter", "HTTPS API", "Authenticates devices; serves their commands; accepts push data and results")
  Component(legacy, "Legacy API Client", "HTTP client", "Calls the monolith with service authentication")
  Component(ingest, "Ingestion and Normalization", "Module", "Source, bindingVersion, correlation_id; skips stale messages")
  Component(relay, "Outbox Relay", "Background worker", "Publishes measurements and results to the internal vhost")
}
ContainerDb(db, "Connectivity DB", "PostgreSQL", "Dedicated database and role")

Rel(broker, inbox, "CommandRequested / PollRequested")
Rel(expiry, db, "Status + outbox in one transaction")
Rel(inbox, db, "Inbox + job in one transaction")
Rel(dispatcher, db, "Picks up jobs; stores attempts")
Rel(dispatcher, registry, "ACTIVE / bindingVersion / owner")
Rel(dispatcher, access, "Dispatch permission")
Rel(http, dispatcher, "Validation before dispatch")
Rel(ingest, registry, "Current binding")
Rel(dispatcher, http, "HTTP / legacy polling")
Rel(dispatcher, mqtt, "Selects MQTT")
Rel(dispatcher, legacy, "Legacy polling / legacy push commands")
Rel(monolith, http, "Legacy polling", "Internal HTTP")
Rel(http, db, "Pending command, existing ID, TTL")
Rel(mqtt, device_bus, "Publishes commands", "AMQP")
Rel(device_bus, mqtt, "Device telemetry and results", "AMQP")
Rel(devices, device_bus, "Outbound connection; telemetry, commands, results", "MQTT / TLS")
Rel(devices, http, "Fetches commands / sends data")
Rel(legacy, monolith, "Poll / command")
Rel(mqtt, ingest, "Message from the device vhost")
Rel(http, ingest, "Validated device data")
Rel(legacy, ingest, "Legacy protocol response")
Rel(ingest, db, "Result + outbox in one transaction")
Rel(relay, db, "Reads / marks outbox messages")
Rel(relay, broker, "MeasurementReceived / CommandResult / DeliveryClosed / PollFailed")
SHOW_LEGEND()
@enduml
