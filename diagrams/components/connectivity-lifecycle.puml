@startuml
!include <C4/C4_Component>
title Warmhouse — Components: Provisioning and Access Revocation
LAYOUT_TOP_DOWN()
skinparam nodesep 35
skinparam ranksep 50
Container(registry, "Device Registry", "HTTP API", "Home, binding and device profile")
Container(access, "Home Access", "HTTP API", "Current permission of the command author")
Container(broker, "RabbitMQ", "AMQP", "Internal vhost; ACK / confirms")
Container(device_bus, "RabbitMQ: Device Vhost", "MQTT / TLS", "Same broker; topic, exchange and queue ACLs")
System_Ext(devices, "Modern Devices", "One-time HTTPS bootstrap after pairing")
Container_Boundary(service, "Device Connectivity (Provisioning View)") {
  Component(provision, "Provisioning and Revocation", "Consumer / HTTPS bootstrap", "Revokes old credentials; issues new credentials and ACLs")
  Component(relay, "Outbox Relay", "Background worker", "ProvisioningCompleted / DeliveryClosed after commit")
}
ContainerDb(db, "Connectivity DB", "PostgreSQL", "Dedicated database and role")
Rel(broker, provision, "ProvisioningRequested / DeviceBindingChanged / AccessChanged")
Rel(provision, access, "Revalidates permissions on AccessChanged")
Rel(provision, registry, "Validates current binding before applying changes")
Rel(provision, db, "Dedup + provisioning / job cancellation + outbox")
Rel(provision, device_bus, "Manages credentials, ACLs and sessions", "Internal management API")
Rel(devices, provision, "One-time bootstrap after pairing", "HTTPS")
Rel(relay, db, "Reads / marks outbox messages")
Rel(relay, broker, "ProvisioningCompleted / DeliveryClosed", "AMQP")
SHOW_LEGEND()
@enduml
