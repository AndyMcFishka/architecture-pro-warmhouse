@startuml
!include <C4/C4_Component>

title Warmhouse — компоненты сервиса телеметрии
LAYOUT_TOP_DOWN()

Container(proxy, "Обратный прокси", "Nginx", "Запросы веб-клиента")
Container(monolith, "Монолит", "Go / Gin", "Реестр датчиков, старый API и опрос старого оборудования")
Container(rules, "Сценарии", "HTTP API", "Проверка условий по измерениям")

Container_Boundary(telemetry, "Телеметрия") {
    Component(api, "HTTP API", "Обработчики запросов", "Последние показания и история; совместимый API температуры для монолита")
    Component(poller, "Опрос датчиков", "Периодическая задача", "Получает список датчиков, выбирает адаптер, проверяет и сохраняет измерения")
    Component(monolithClient, "Клиент монолита", "HTTP-клиент", "Читает реестр и параметры подключения; опрашивает старые датчики")
    Component(deviceClient, "Адаптер новых датчиков", "HTTPS-клиент", "Запрашивает и приводит показания к общему формату")
}

ContainerDb(db, "Измерения", "PostgreSQL: схема telemetry", "Датчик, величина, значение, единица и время; история измерений")
System_Ext(sensors, "Новые датчики", "Поддерживаемый HTTPS API измерений")

Rel(proxy, api, "Показания и история", "HTTP")
Rel(monolith, api, "Температура по ID или локации", "HTTP")
Rel(rules, api, "Последние показания и их время", "HTTP")
Rel(api, db, "Читает измерения", "SQL")
Rel(api, monolithClient, "Находит датчик по локации", "Вызов")
Rel(poller, monolithClient, "Реестр; опрос старого датчика", "Вызов")
Rel(poller, deviceClient, "Опрос нового датчика", "Вызов")
Rel(poller, db, "Сохраняет корректные измерения", "SQL")
Rel(monolithClient, monolith, "Реестр / внутренний API опроса", "HTTP")
Rel(deviceClient, sensors, "Запрашивает показания", "HTTPS")

note bottom of poller
  Интервал опроса и таймаут настраиваются.
  Способ подключения берётся из реестра.
  Ошибка датчика не останавливает опрос остальных
  и не обновляет время последнего измерения.
end note

note bottom of api
  Чтение не запускает новый опрос.
  Ответ содержит время и признак устаревания;
  отсутствие измерений не заменяется нулём.
  Здесь только измерения датчиков,
  без команд и состояний ворот или света.
end note

note bottom of monolithClient
  Внутренний API опрашивает старое оборудование напрямую,
  не вызывает API телеметрии повторно.
end note
@enduml
