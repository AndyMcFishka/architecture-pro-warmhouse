@startuml
!include <C4/C4_Component>
title Warmhouse — Components: Telemetry
LAYOUT_TOP_DOWN()
skinparam nodesep 30
skinparam ranksep 50

Container(client, "Web Client / Services", "HTTPS / HTTP", "JWT / service identity")
Container(monolith, "Monolith / Legacy Adapter", "Go / Gin", "Reads temperature from Telemetry")
Container(idp, "Keycloak", "OIDC / JWKS", "JWT keys; JWKS cache")
Container(access, "Home Access", "HTTP API", "Validates current home permissions")
Container(registry, "Device Registry", "HTTP API", "Home, binding and device profile")
Container(broker, "RabbitMQ", "AMQP", "Internal vhost; ACK / confirms")
Container_Boundary(service, "Telemetry") {
  Component(api, "Measurement API", "HTTP", "Latest value and history; measurement time and freshness")
  Component(auth, "Access Validation", "Module", "JWT: issuer, audience, expiry; service identity")
  Component(scheduler, "Poll Scheduler", "Background worker", "Scheduled PollRequested")
  Component(ingest, "Measurement Consumer", "AMQP consumer", "Format, dedup, bindingVersion; skips stale messages")
  Component(relay, "Outbox Relay", "Background worker", "Poll requests and MeasurementRecorded after commit")
}
ContainerDb(db, "Telemetry DB", "PostgreSQL", "Dedicated database and role")

Rel(monolith, api, "Reading and timestamp", "HTTP / service authentication")
Rel(client, api, "Reads measurements")
Rel(api, auth, "Verifies identity")
Rel(auth, idp, "Fetches JWKS")
Rel(auth, access, "Checks home read permission")
Rel(auth, registry, "Current home / ACTIVE / bindingVersion")
Rel(api, db, "Reads authorized measurements")
Rel(scheduler, registry, "Fetches pull devices and intervals")
Rel(scheduler, db, "Poll slot + outbox in one transaction")
Rel(broker, ingest, "MeasurementReceived / PollFailed")
Rel(ingest, registry, "ACTIVE / bindingVersion")
Rel(ingest, db, "Measurement + dedup + outbox in one transaction")
Rel(relay, db, "Reads / marks outbox messages")
Rel(relay, broker, "PollRequested / MeasurementRecorded")
SHOW_LEGEND()
@enduml
