@startuml
!include <C4/C4_Component>
title Warmhouse — Components: Monolith as Legacy Adapter
LAYOUT_TOP_DOWN()
skinparam nodesep 30
skinparam ranksep 50

Container(transport, "Device Connectivity", "Internal HTTP API", "Initiates polling and command delivery")
System_Ext(devices, "Legacy Equipment", "Heating sensors and controllers; legacy protocol")
Container(telemetry, "Telemetry", "Internal HTTP API", "Temperature, measurement time and freshness")
Container(registry, "Device Registry", "Internal HTTP API", "Device registry and connectivity profiles")
Container_Boundary(service, "Monolith as Legacy Adapter") {
  Component(polling, "Polling Controller Facade", "Legacy HTTP", "Identity / ID; device record and desiredStatus")
  Component(api, "Internal Adapter API", "Go / Gin", "Separate polling and command operations; service authentication")
  Component(read, "Device and Measurement Reader", "Go / HTTP", "Reads new APIs without polling the sensor")
  Component(mapping, "Identifier Mapping", "Go", "Maps device_id to legacy protocol address and identifier")
  Component(poll, "Legacy Sensor Poller", "Go / HTTP", "Physical polling; timeout and response parsing")
  Component(commands, "Command Adapter", "Go; implementation required", "Converts commands to the legacy protocol; never fabricates acknowledgements")
  Component(dedup, "Command Attempt Tracker", "SQL", "Stable command_id; duplicate dispatch protection and unknown outcomes")
}
ContainerDb(db, "Legacy DB", "PostgreSQL", "Dedicated database and role")

Rel(transport, api, "Requests a poll / command")
Rel(polling, read, "Device record and reading")
Rel(devices, polling, "Floor heating controller polls its own status by ID")
Rel(polling, transport, "Authorized pending command", "HTTP; service + device identity")
Rel(polling, dedup, "commandId / desiredStatus")
Rel(read, telemetry, "Reading and timestamp", "HTTP / service authentication")
Rel(read, registry, "Device records and profiles", "HTTP / service authentication")
Rel(api, mapping, "Resolves device_id")
Rel(mapping, db, "Reads technical settings")
Rel(api, poll, "Poll")
Rel(api, commands, "Command")
Rel(commands, dedup, "commandId / attempt")
Rel(dedup, db, "Persists attempt state")
Rel(poll, devices, "Requests a measurement")
Rel(commands, devices, "Sends a legacy push command")
SHOW_LEGEND()
@enduml
