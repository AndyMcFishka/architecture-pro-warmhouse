@startuml
!include <C4/C4_Component>
title Warmhouse — Components: Automation
LAYOUT_TOP_DOWN()
skinparam nodesep 30
skinparam ranksep 50

Container(client, "Web Client / Services", "HTTPS / HTTP", "JWT / service identity")
Container(idp, "Keycloak", "OIDC / JWKS", "JWT keys; JWKS cache")
Container(access, "Home Access", "HTTP API", "Validates current home permissions")
Container(registry, "Device Registry", "HTTP API", "Home, binding and device profile")
Container(broker, "RabbitMQ", "AMQP", "Internal vhost; ACK / confirms")
Boundary(command_services, "Control Contexts — Four Services") {
  Container(heating, "Heating Control", "HTTP API", "Permissions, bindings and commands")
  Container(lighting, "Lighting Control", "HTTP API", "Permissions, bindings and commands")
  Container(gates, "Gate Control", "HTTP API", "Permissions, bindings and commands")
  Container(video, "Video Control", "HTTP API", "Camera commands; permission and binding checks")
}
Container_Boundary(service, "Automation") {
  Component(api, "Automation Rule API", "HTTP", "Create, update, enable and disable rules")
  Component(auth, "Access Validation", "Module", "JWT: issuer, audience, expiry; service identity")
  Component(rules, "Rule Evaluator", "Module", "Conditions, actions, owner and bindingVersion")
  Component(triggers, "Events and Schedules", "Consumer / timer", "Freshness and bindingVersion; trigger or disable on permission / binding revocation")
  Component(runner, "Rule Runner", "Background worker", "Revalidates rule, bindings and permissions; calls domain API")
}
ContainerDb(db, "Automation DB", "PostgreSQL", "Dedicated database and role")

Rel(client, api, "Configures an automation rule", "")
Rel(api, auth, "Validates JWT", "")
Rel(auth, idp, "Fetches JWKS", "")
Rel(auth, access, "Checks permissions", "")
Rel(api, rules, "After access validation", "")
Rel(rules, registry, "Validates rule devices", "")
Rel(rules, db, "Stores rules", "")
Rel(broker, triggers, "MeasurementRecorded / DeviceBindingChanged / AccessChanged", "")
Rel(triggers, registry, "Current bindings", "")
Rel(runner, registry, "Bindings of all devices", "")
Rel(triggers, db, "Dedup + run in one transaction", "")
Rel(runner, db, "Picks up unfinished runs", "")
Rel(runner, access, "Owner permissions", "")
Rel(runner, command_services, "Command to the appropriate service + runId", "HTTP / service authentication")
Lay_R(heating, lighting)
Lay_D(heating, gates)
Lay_R(gates, video)
SHOW_LEGEND()
@enduml
