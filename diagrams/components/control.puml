@startuml
!include <C4/C4_Component>
title Warmhouse — Components: Heating Control
LAYOUT_TOP_DOWN()
skinparam nodesep 30
skinparam ranksep 50

Container(client, "Client / Automation", "HTTPS / HTTP", "User or verified automation rule owner context")
Container(idp, "Keycloak", "OIDC / JWKS", "JWT keys; JWKS cache")
Container(access, "Home Access", "HTTP API", "Validates current home permissions")
Container(registry, "Device Registry", "HTTP API", "Home, binding and device profile")
Container(broker, "RabbitMQ", "AMQP", "Internal vhost; ACK / confirms")
Container_Boundary(service, "Heating Control") {
  Component(api, "Command and Status API", "HTTP", "Command, Idempotency-Key; returns command_id")
  Component(auth, "Access Validation", "Module", "JWT: issuer, audience, expiry; service identity")
  Component(commands, "Command Handler", "Module", "Heating rules; Command + sequence + outbox")
  Component(results, "Result Consumer", "AMQP consumer", "Dedup, resultVersion; CommandResult / DeliveryClosed")
  Component(relay, "Outbox Relay", "Background worker", "CommandRequested; mandatory + confirm without return")
}
ContainerDb(db, "Heating DB", "PostgreSQL", "Dedicated database and role")

Rel(client, api, "Creates a command / reads status")
Rel(api, auth, "Verifies identity")
Rel(auth, idp, "Fetches JWKS")
Rel(auth, registry, "Resolves device and home")
Rel(auth, access, "Checks current permissions")
Rel(api, commands, "After access validation")
Rel(commands, registry, "Capabilities / commandOwner")
Rel(commands, db, "Command + sequence + outbox")
Rel(relay, db, "Reads / marks outbox messages")
Rel(relay, broker, "Publishes commands")
Rel(broker, results, "CommandResult / DeliveryClosed")
Rel(results, registry, "CommandResult binding validity")
Rel(results, db, "Result + processed event in one transaction")
SHOW_LEGEND()
@enduml
