@startuml
!include <C4/C4_Context>

title Warmhouse — To-Be: System Context
LAYOUT_TOP_DOWN()
skinparam nodesep 65
skinparam ranksep 65

Person(user, "User", "Connects devices independently, controls the home, configures automation rules, views readings and video")

System(warmhouse, "Warmhouse", "SaaS platform: homes and access, device registry, heating, lighting, gates, telemetry, automation and video access")
System_Ext(legacy, "Legacy Equipment", "Previously installed heating sensors and controllers; may poll their own status by ID")
System_Ext(modern, "Modern Partner Devices", "Sensors, heating, lighting and gate controllers, cameras; supported standard protocols")

Rel_(user, warmhouse, "Connects devices, controls the home, configures rules; gets readings and video URLs", "Web UI", "-[norank]->")
Rel_(warmhouse, legacy, "Requests measurements and sends commands", "Legacy protocol", "-[norank]->")
Rel_(legacy, warmhouse, "Reconnects; floor heating controller polls its desired status", "Legacy protocol / polling", "-[norank]->")
Rel_(modern, warmhouse, "Establishes an outbound connection or polls the platform; sends measurements and receives commands", "MQTT / TLS or HTTPS", "-[norank]->")
Rel_(user, modern, "Views the camera stream directly through an authorized URL", "Client application", "-[norank]->")

Lay_D(user, warmhouse)
Lay_D(warmhouse, legacy)
Lay_R(legacy, modern)

Rel_(warmhouse, modern, "Obtains a temporary stream URL through the camera API", "HTTPS", "-[norank]->")
SHOW_LEGEND()
@enduml
