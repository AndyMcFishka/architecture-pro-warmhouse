@startuml
!include <C4/C4_Context>

title Тёплый дом — To-Be: диаграмма контекста
LAYOUT_TOP_DOWN()
skinparam nodesep 65
skinparam ranksep 65

Person(user, "Пользователь", "Самостоятельно подключает устройства, управляет домом, настраивает сценарии и просматривает показания и видео")

System(warmhouse, "Тёплый дом", "SaaS-платформа: дома и права доступа, учёт устройств, управление отоплением, свет, ворота, телеметрия, автоматизация и видеодоступ")
System_Ext(legacy, "Старое оборудование", "Ранее установленные датчики и контроллеры отопления; возможен polling своего статуса по ID")
System_Ext(modern, "Новые устройства партнёров", "Датчики, контроллеры отопления, света и ворот, камеры; поддерживаемые стандартные протоколы")

Rel_(user, warmhouse, "Подключает устройства, управляет домом, задаёт сценарии; получает показания и ссылки на видео", "Веб-интерфейс", "-[norank]->")
Rel_(warmhouse, legacy, "Запрашивает измерения и передаёт команды", "Старый протокол", "-[norank]->")
Rel_(legacy, warmhouse, "Повторно подключается; контроллер тёплого пола опрашивает свой целевой статус", "Старый протокол / polling", "-[norank]->")
Rel_(modern, warmhouse, "Устанавливает исходящее соединение или опрашивает платформу; передаёт измерения и получает команды", "MQTT / TLS или HTTPS", "-[norank]->")
Rel_(user, modern, "Просматривает поток камеры напрямую по разрешённой ссылке", "Клиентское приложение", "-[norank]->")

Lay_D(user, warmhouse)
Lay_D(warmhouse, legacy)
Lay_R(legacy, modern)

footer
  Монолит-адаптер, микросервисы, Keycloak, RabbitMQ и базы данных — внутри платформы.
  Их структура показана на уровне Containers. Камеры включены в блок новых устройств.
end footer
Rel_(warmhouse, modern, "Получает временную ссылку на поток через API камеры", "HTTPS", "-[norank]->")
SHOW_LEGEND()
@enduml
