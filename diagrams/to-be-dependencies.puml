@startuml
!include <C4/C4_Container>

title Тёплый дом — To-Be: контейнеры — доступ и реестр
LAYOUT_TOP_DOWN()
skinparam nodesep 35
skinparam ranksep 55


System_Boundary(platform, "Тёплый дом — целевая архитектура") {
  Container(access, "Дома и доступ", "HTTP", "Дома, участники и права")
  Container(registry, "Учёт устройств", "HTTP", "Привязки, возможности и профиль связи")
  Container(automation, "Автоматизация", "HTTP / AMQP", "Правила, расписания и запуск действий")
  Container(telemetry, "Телеметрия", "HTTP / AMQP", "Показания и планировщик опроса")
  Container(monolith, "Монолит / legacy-адаптер", "Go / Gin", "Legacy push / polling-фасад")
  Container(transport, "Взаимодействие с устройствами", "HTTP / AMQP / MQTT", "Доставка, протоколы и подтверждения")
  Container(heating, "Отопление", "HTTP / AMQP", "Команды отоплению")
  Container(lighting, "Освещение", "HTTP / AMQP", "Команды освещению")
  Container(gates, "Ворота", "HTTP / AMQP", "Команды воротам")
  Container(video, "Видеонаблюдение", "HTTP / AMQP", "Команды камерам и видеодоступ")
}

Rel_U(telemetry, registry, "Профили опроса", "HTTP")
Rel_U(transport, registry, "Профиль связи", "HTTP")
Rel_D(heating, access, "Права на действие", "HTTP")
Rel_D(lighting, access, "Права на действие", "HTTP")
Rel_D(gates, access, "Права на действие", "HTTP")
Rel_D(video, access, "Права на действие", "HTTP")
Rel_D(heating, registry, "Устройство / дом", "HTTP")
Rel_D(lighting, registry, "Устройство / дом", "HTTP")
Rel_D(gates, registry, "Устройство / дом", "HTTP")
Rel_D(video, registry, "Устройство / дом", "HTTP")
footer
  Все API, доступные пользователю, проверяют JWT по ключам Keycloak (JWKS, кэш).
  Владение БД показано на отдельной диаграмме хранения.
  HTTP между сервисами требует сервисной аутентификации.
end footer
Rel_L(registry, access, "Права на действие", "HTTP")
Rel_U(telemetry, access, "Право чтения", "HTTP")
Rel_U(automation, access, "Права владельца", "HTTP")
Rel_U(automation, registry, "Привязки сценария", "HTTP")

Rel_L(monolith, telemetry, "Последнее измерение", "HTTP")
Rel_U(monolith, registry, "Карточка устройства", "HTTP")

' Visual order only: API clients, supporting services, storage.

Rel_U(transport, access, "Право на выдачу", "HTTP")
Rel_L(monolith, transport, "Pending-команда", "HTTP")
Lay_R(heating, lighting)
Lay_R(lighting, gates)
Lay_R(gates, video)
Lay_R(access, registry)
Lay_R(automation, telemetry)
Lay_R(telemetry, transport)
Lay_R(transport, monolith)
skinparam footerFontSize 11
SHOW_LEGEND()
@enduml
