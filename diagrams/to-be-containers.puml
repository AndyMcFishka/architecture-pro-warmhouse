@startuml
!include <C4/C4_Container>

title Warmhouse — контейнеры MVP: новые сервисы рядом с монолитом
LAYOUT_TOP_DOWN()

Person(user, "Пользователь", "Подключает устройства, управляет домом и смотрит показания")

System_Boundary(platform, "Warmhouse") {
    Container(web, "Веб-клиент", "Браузер", "Существующий интерфейс с новыми функциями")
    Container(proxy, "Обратный прокси", "Nginx", "Один HTTPS-вход; маршрутизация по URL; раздача веб-клиента")
    Container(monolith, "Монолит", "Go / Gin", "Существующий API и реестр устройств. Добавляем внутренний API старого оборудования")
    Container(devices, "Устройства", "HTTP API", "Самостоятельное подключение через реестр монолита; адаптеры доставки команд новым устройствам")
    Container(telemetry, "Телеметрия", "HTTP API", "Получение и хранение показаний; совместимый API температуры для монолита")
    Container(heating, "Отопление", "HTTP API", "Установить состояние отопления; состояние команды и ключ повтора")
    Container(lighting, "Освещение", "HTTP API", "Установить состояние света; состояние команды и ключ повтора")
    Container(gates, "Ворота", "HTTP API", "Запереть / отпереть; состояние команды и ключ повтора")
    Container(video, "Видеонаблюдение", "HTTP API", "Получить временную ссылку на поток камеры")
    Container(rules, "Сценарии", "HTTP API + периодическая проверка", "Простые правила по показаниям; вызов сервисов управления")
    ContainerDb(db, "Существующий сервер БД", "PostgreSQL", "Монолит владеет реестром устройств. Новые сервисы — своими схемами и ролями: показания, команды, подключения, сценарии")
}

System_Ext(legacy, "Старое оборудование", "Существующие датчики и контроллеры отопления")
System_Ext(equipment, "Новые устройства партнёров", "Поддерживаемый HTTPS API; доступность серверу — условие подключения")
System_Ext(camera, "Камеры партнёров", "HTTPS API временных ссылок и доступный браузеру защищённый поток")

Rel(user, web, "Работает с домом")
Rel(web, proxy, "Запросы API", "HTTPS / JSON")
Rel(proxy, monolith, "Старый API", "HTTP")
Rel(proxy, devices, "Подключение устройств", "HTTP")
Rel(proxy, telemetry, "Показания", "HTTP")
Rel(proxy, heating, "Отопление", "HTTP")
Rel(proxy, lighting, "Свет", "HTTP")
Rel(proxy, gates, "Ворота", "HTTP")
Rel(proxy, video, "Доступ к видео", "HTTP")
Rel(proxy, rules, "Настройка сценариев", "HTTP")

Rel(monolith, telemetry, "Читает температуру через существующий HTTP-клиент", "HTTP")
Rel(devices, monolith, "Читает / меняет реестр; передаёт команды старому оборудованию", "HTTP")
Rel(telemetry, monolith, "Получает список устройств; запрашивает опрос старого датчика", "Внутренний HTTP API")
Rel(monolith, legacy, "Опрашивает датчики; передаёт команды отоплению", "Существующий протокол / локальная сеть")
Rel(telemetry, equipment, "Опрашивает датчики", "HTTPS")
Rel(heating, devices, "Передаёт команду с постоянным ID", "HTTP")
Rel(lighting, devices, "Передаёт команду с постоянным ID", "HTTP")
Rel(gates, devices, "Передаёт команду с постоянным ID", "HTTP")
Rel(devices, equipment, "Устанавливает состояние; получает результат", "HTTPS")
Rel(video, monolith, "Получает данные камеры", "HTTP")
Rel(video, camera, "Запрашивает временную ссылку", "HTTPS")
Rel(web, camera, "Получает видео по временной ссылке", "HTTPS")
Rel(rules, telemetry, "Читает свежие показания", "HTTP")
Rel(rules, heating, "Выполняет правило", "HTTP")
Rel(rules, lighting, "Выполняет правило", "HTTP")
Rel(rules, gates, "Выполняет правило", "HTTP")

Rel(monolith, db, "Реестр устройств", "SQL")
Rel(devices, db, "Подключения и попытки доставки", "SQL: своя схема")
Rel(telemetry, db, "История показаний", "SQL: своя схема")
Rel(heating, db, "Команды отопления", "SQL: своя схема")
Rel(lighting, db, "Команды освещения", "SQL: своя схема")
Rel(gates, db, "Команды ворот", "SQL: своя схема")
Rel(rules, db, "Правила и запуски", "SQL: своя схема")

note right of monolith
  Проектируемые доработки, а не готовые функции:
  регистрация новых типов устройств,
  API опроса и команд старому оборудованию.
  Внутренний опрос обращается к оборудованию,
  не вызывает телеметрию повторно.
end note

note as auth_scope
  За рамками демонстрационного MVP:
  аутентификация и проверка прав.
  Нужны до открытия доступа через интернет.
end note

legend bottom
  Демонстрационный MVP в изолированной среде, без публичного доступа.
  Вход через прокси; развёртывание — Docker Compose.
  Ключ повтора и команда сохраняются до отправки; повтор возвращает ту же команду.
  Неясный результат доставки — UNKNOWN, а не успех; без поддержки устройства
  автоматический повтор физической операции не гарантируется.
  Новый тип устройства требует совместимого адаптера и проверки интеграции.
  Брокера сообщений нет. Это проект MVP, ещё не реализованный код.
endlegend
@enduml
