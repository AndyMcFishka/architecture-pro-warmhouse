@startuml
!include <C4/C4_Container>

title Warmhouse — To-Be: Containers — Commands and Measurements
LAYOUT_TOP_DOWN()
skinparam nodesep 35
skinparam ranksep 55

Person(user, "User", "Views measurements and controls their home")
System_Ext(legacy, "Legacy Equipment", "Heating sensors and controllers on a private network")
System_Ext(modern, "Modern Devices", "Outbound MQTT connections or HTTPS command polling; push telemetry")

System_Boundary(platform, "Warmhouse — Target Architecture") {
  Container(web, "Web Client", "Web application", "Homes, devices, automation rules and video")
  Container(access, "Home Access", "HTTP API", "Homes, members and permissions")
  Container(registry, "Device Registry", "HTTP API", "Bindings, capabilities and connectivity profiles")
  Container(identity, "Identity Provider", "Keycloak / OpenID Connect", "Sign-in and user tokens")
  Container(automation, "Automation", "HTTP API / AMQP", "Rules, schedules and action execution")
  Container(telemetry, "Telemetry", "HTTP API / AMQP", "Readings and poll scheduling")
  Container(monolith, "Monolith / Legacy Adapter", "Go / Gin", "Legacy push / polling facade")
  Container(transport, "Device Connectivity", "HTTP / AMQP / MQTT", "Delivery, protocols and acknowledgements")
  Boundary(control, "Control Contexts", "Logical group") {
    Container(heating, "Heating Control", "HTTP API / AMQP", "Heating commands")
    Container(lighting, "Lighting Control", "HTTP API / AMQP", "Lighting commands")
    Container(gates, "Gate Control", "HTTP API / AMQP", "Gate commands")
    Container(video, "Video Control", "HTTP API / AMQP", "Camera commands and video access")
  }
  ContainerQueue(broker, "Message Broker", "RabbitMQ + MQTT plugin", "Internal and MQTT vhosts")
}

Rel_(user, web, "Interacts with the home", "", "-[norank]->")
Rel_(web, identity, "Signs in and obtains tokens", "OIDC / HTTPS", "-[norank]->")
Rel_(telemetry, broker, "Poll requests, measurements", "AMQP", "-[norank]->")
Rel_(transport, broker, "Commands / events; vhost bridge", "AMQP", "-[norank]->")
Rel_(modern, broker, "Telemetry, commands, results", "MQTT / TLS", "-[norank]->")
Rel_(modern, transport, "Polling / readings / results", "HTTPS, device authentication", "-[norank]->")

Rel_(web, control, "Commands / statuses", "HTTPS / JWT", "-[norank]->")
Rel_(automation, control, "Triggers an action", "HTTP", "-[norank]->")
Rel_(control, broker, "Commands / results", "AMQP", "-[norank]->")
Rel_(web, video, "Obtains a stream URL", "HTTPS / JWT", "-[norank]->")

Rel_(transport, monolith, "Legacy device polling and commands", "HTTP / service authentication", "-[norank]->")
Rel_(monolith, legacy, "Polling / push commands", "Intranet / legacy protocol", "-[norank]->")

Rel_(web, registry, "Connects and configures devices", "HTTPS / JWT", "-[norank]->")
Rel_(web, access, "Manages homes and members", "HTTPS / JWT", "-[norank]->")
Rel_(web, telemetry, "Reads measurements", "HTTPS / JWT", "-[norank]->")
Rel_(web, automation, "Configures automation rules", "HTTPS / JWT", "-[norank]->")
Rel_(automation, broker, "Measurements / access changes", "AMQP", "-[norank]->")

Rel_(registry, broker, "Bindings / provisioning", "AMQP", "-[norank]->")
Rel_(access, broker, "Permission changes", "AMQP / outbox", "-[norank]->")
Rel_(web, modern, "Direct video stream", "Secure media protocol", "-[norank]->")
Rel_(legacy, monolith, "Polls its own status", "Legacy / pull; device authentication", "-[norank]->")
Rel_(monolith, transport, "Pending command", "Internal HTTP / service authentication", "-[norank]->")
Rel_(video, modern, "Temporary URL", "HTTPS / server credentials", "-[norank]->")
' Layout only: rows and columns of a grid, no new dependencies.
Lay_D(user, web)
Lay_R(web, identity)
Lay_D(web, registry)
Lay_R(access, registry)
Lay_R(registry, automation)
Lay_R(automation, telemetry)
Lay_D(access, heating)
Lay_D(registry, lighting)
Lay_D(automation, gates)
Lay_D(telemetry, video)
Lay_R(heating, lighting)
Lay_R(lighting, gates)
Lay_R(gates, video)
Lay_R(control, broker)
Lay_R(broker, transport)
Lay_R(transport, monolith)
Lay_D(transport, modern)
Lay_D(monolith, legacy)
Lay_R(modern, legacy)
SHOW_LEGEND()
@enduml
