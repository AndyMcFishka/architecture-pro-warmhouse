@startuml
!include <C4/C4_Container>

title Warmhouse — контейнеры MVP: новые сервисы рядом с монолитом
LAYOUT_TOP_DOWN()

Person(user, "Пользователь", "Управляет умным домом")

System_Boundary(platform, "Warmhouse") {
    Container(web, "Веб-клиент", "Браузер", "Интерфейс умного дома")
    Container(proxy, "Обратный прокси", "Nginx", "Один вход, маршрутизация по URL")
    Container(monolith, "Монолит", "Go / Gin", "Реестр и API старого оборудования")
    Container(devices, "Устройства", "HTTP API", "Подключение и доставка команд")
    Container(telemetry, "Телеметрия", "HTTP API", "Получение и хранение показаний")
    Container(heating, "Отопление", "HTTP API", "Включить / выключить отопление")
    Container(lighting, "Освещение", "HTTP API", "Включить / выключить свет")
    Container(gates, "Ворота", "HTTP API", "Запереть / отпереть ворота")
    Container(video, "Видеонаблюдение", "HTTP API", "Доступ к потоку камеры")
    Container(rules, "Сценарии", "HTTP API", "Правила по показаниям")
    ContainerDb(db, "Существующий сервер БД", "PostgreSQL", "Своя схема и роль у каждого сервиса с хранилищем. SQL-связи опущены")
}

System_Ext(legacy, "Старое оборудование", "Датчики и отопление")
System_Ext(equipment, "Новые устройства партнёров", "Датчики, свет, ворота, отопление")
System_Ext(camera, "Камеры партнёров", "API доступа и видеопоток")

Rel(user, web, "Работает с домом")
Rel(web, proxy, "Запросы API", "HTTPS / JSON")
Rel(proxy, monolith, "Старый API", "HTTP")
Rel(proxy, devices, "Подключение устройств", "HTTP")
Rel(proxy, telemetry, "Показания", "HTTP")
Rel(proxy, heating, "Отопление", "HTTP")
Rel(proxy, lighting, "Свет", "HTTP")
Rel(proxy, gates, "Ворота", "HTTP")
Rel(proxy, video, "Доступ к видео", "HTTP")
Rel(proxy, rules, "Настройка сценариев", "HTTP")

Rel(monolith, telemetry, "Читает температуру", "HTTP")
Rel(devices, monolith, "Реестр и старые команды", "HTTP")
Rel(telemetry, monolith, "Реестр и опрос датчиков", "HTTP")
Rel(monolith, legacy, "Опрос и команды", "Старый протокол")
Rel(telemetry, equipment, "Опрашивает датчики", "HTTPS")
Rel(heating, devices, "Команды", "HTTP")
Rel(lighting, devices, "Команды", "HTTP")
Rel(gates, devices, "Команды", "HTTP")
Rel(devices, equipment, "Команды", "HTTPS")
Rel(video, monolith, "Данные камеры", "HTTP")
Rel(video, camera, "Ссылка на поток", "HTTPS")
Rel(web, camera, "Видео напрямую", "HTTPS")


note as auth_scope
  За рамками демонстрационного MVP:
  аутентификация и проверка прав.
  Нужны до открытия доступа через интернет.
end note

legend bottom
  Межсервисные вызовы — HTTP, без брокера.
  Сценарии читают телеметрию и вызывают отопление, свет и ворота;
  эти связи и SQL-связи опущены для читаемости.
  Проект демонстрационного MVP, запуск в изолированной среде.
endlegend
@enduml
